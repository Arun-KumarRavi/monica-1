FROM php:8.3-fpm

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libpng-dev \
    libzip-dev \
    libxml2-dev \
    libcurl4-openssl-dev \
    git \
    unzip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js v20 (required by EspoCRM build process)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

# Configure and install required PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) gd \
    && docker-php-ext-install pdo pdo_mysql zip xml curl bcmath pcntl posix opcache exif

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY . .

# Build the application dependencies and frontend assets inside the image
RUN composer install --no-interaction --no-dev --optimize-autoloader \
    && npm install \
    && npm run build

# Ensure correct permissions for www-data, including the data directory
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 775 /var/www/html/data || true
